// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TALI
}

enum MembershipType {
  STANDARD
  PREMIUM
}

enum InsuranceType {
  TRAFIK
  KASKO
  SAGLIK
  DASK
  KONUT
}

enum RequestStatus {
  PENDING_OFFER
  OFFER_READY
  PAYMENT_PENDING
  PAYMENT_REVIEW
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  COMMISSION
  PAYMENT
  REFUND
  GOAL_REWARD
  MARKET_PURCHASE
}

enum TransactionStatus {
  SUCCESS
  PENDING
}

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  auditLogs AuditLog[]
  role      Role     @default(TALI)
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taliProfile TaliProfile?
  transactions Transactions[]
  messages    Message[]
  notifications Notification[]
}

model TaliProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  
  fullName    String
  tcKimlikNo  String?
  phone       String?
  address     String?
  birthDate   DateTime?
  
  membershipType MembershipType @default(STANDARD)
  points         Decimal        @default(0)
  
  trustScore     Int            @default(100)
  
  hasKvkkApproval Boolean @default(false)
  hasContractApproval Boolean @default(false)
  
  allowedInsuranceTypes String[] @default([]) // Empty means ALL allowed

  customers         Customer[]
  insuranceRequests InsuranceRequest[]
  goals             TaliGoal[]
  rewards           Reward[]
  purchases         MarketPurchase[]
  premiumRequests   PremiumRequest[]
  badges            TaliBadge[]
}

model Customer {
  id        String   @id @default(uuid())
  taliId    String
  tali      TaliProfile @relation(fields: [taliId], references: [id])
  tc_kn     String   @unique
  fullName  String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insuranceRequests InsuranceRequest[]

  // Performance indexes
  @@index([taliId, createdAt])
  @@index([fullName])
}

model InsuranceRequest {
  id           String        @id @default(uuid())
  taliId       String
  tali         TaliProfile   @relation(fields: [taliId], references: [id])
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  type         InsuranceType
  status       RequestStatus @default(PENDING_OFFER)
  details      Json // Flexible JSON for different insurance types
  
  // Offer details
  offers       Json? // Array of offers from admins
  selectedOffer Json? // The offer selected by Tali
  adminOfferPrice Decimal?
  adminOfferCompany String?
  adminOfferDescription String?
  policyUrl String? // URL of the uploaded policy PDF
  offerFileUrl String? // URL of the single offer file (PDF)

  policy    Policy?
  cancellationRequest CancellationRequest?
  messages            Message[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Performance indexes
  @@index([taliId, status])
  @@index([customerId, createdAt])
  @@index([type, status])
  @@index([status, createdAt])
}

enum PolicyStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model Policy {
  id                 String       @id @default(uuid())
  insuranceRequestId String       @unique
  insuranceRequest   InsuranceRequest @relation(fields: [insuranceRequestId], references: [id])
  
  policyNumber String
  company      String
  startDate    DateTime
  endDate      DateTime
  premium      Decimal
  commissionPoints Decimal      @default(0)
  policyUrl    String?
  status       PolicyStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performance indexes
  @@index([status, endDate])
  @@index([company])
}

model CommissionRate {
  id             String         @id @default(uuid())
  membershipType MembershipType
  insuranceType  InsuranceType
  rate           Float // Percentage
  
  @@unique([membershipType, insuranceType])
}

model Transactions {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  points    Decimal
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  description String?
  createdAt DateTime          @default(now())

  // Performance indexes
  @@index([userId, createdAt])
  @@index([type, status])
}

model CancellationRequest {
  id         String             @id @default(uuid())
  policyId   String             @unique
  policy     InsuranceRequest   @relation(fields: [policyId], references: [id])
  reason     String
  contactPhone String?
  proofFiles String[]
  status     CancellationStatus @default(PENDING)
  adminResponse String?         // Admin's explanation when approving/rejecting
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  // Performance indexes
  @@index([userId, action])
  @@index([createdAt])
}

model Message {
  id                String           @id @default(uuid())
  content           String
  senderId          String
  sender            User             @relation(fields: [senderId], references: [id])
  insuranceRequestId String
  insuranceRequest  InsuranceRequest @relation(fields: [insuranceRequestId], references: [id])
  createdAt         DateTime         @default(now())
  attachmentUrl     String?
}

model InsuranceCompany {
  id        String   @id @default(uuid())
  name      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  type        String   // TEXT, NUMBER, BOOLEAN, JSON
  category    String   // GENERAL, NOTIFICATIONS, COMMISSION, etc.
  description String?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      NotificationType @default(SYSTEM)
  createdAt DateTime @default(now())

  // Performance indexes
  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
}

enum NotificationType {
  SYSTEM
  ADMIN_MESSAGE
  RENEWAL
  OFFER
  POLICY
  CANCELLATION
  PREMIUM
  MARKET
}

model Goal {
  id          String    @id @default(uuid())
  title       String
  description String?
  targetType  GoalTargetType // COUNT, PREMIUM
  policyType  InsuranceType? // Specific type or null for ALL
  targetValue Int       // e.g., 10 policies or 10000 TL
  rewardType  RewardType // POINTS
  rewardPoints Decimal   // e.g., 500 Points
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  taliGoals   TaliGoal[]
}

model TaliGoal {
  id          String    @id @default(uuid())
  taliId      String
  tali        TaliProfile @relation(fields: [taliId], references: [id])
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id])
  currentValue Int      @default(0) // Count or Premium amount
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  @@unique([taliId, goalId])
}

model Reward {
  id          String    @id @default(uuid())
  taliId      String
  tali        TaliProfile @relation(fields: [taliId], references: [id])
  points      Decimal
  description String
  createdAt   DateTime  @default(now())
}

enum GoalTargetType {
  COUNT
  PREMIUM
}

enum RewardType {
  POINTS
}

model WebsiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  type      String   // TEXT, HTML, IMAGE_URL
  value     String   @db.Text
  category  String   // HOME, ABOUT, CONTACT, REFERENCES
  updatedAt DateTime @updatedAt
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

model MarketCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  pointCost   Int
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  type        ProductType @default(PHYSICAL)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   MarketPurchase[]
}

enum PurchaseStatus {
  PENDING
  APPROVED
  SHIPPED
  DELIVERED
  COMPLETED
  REJECTED
}

model MarketPurchase {
  id          String   @id @default(uuid())
  taliId      String
  tali        TaliProfile @relation(fields: [taliId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  pointCost   Int
  status      PurchaseStatus @default(PENDING)
  
  details         Json? // Address, etc.
  fulfillmentData Json? // Tracking code, Coupon code, etc.
  adminNote       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PremiumRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PremiumRequest {
  id          String   @id @default(uuid())
  taliId      String
  tali        TaliProfile @relation(fields: [taliId], references: [id])
  status      PremiumRequestStatus @default(PENDING)
  paymentMethod String // WHATSAPP, VIRTUAL_POS
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// === GAMIFICATION ===

enum BadgeType {
  POLICY_COUNT      // Belirli sayıda poliçe
  PREMIUM_TOTAL     // Toplam prim tutarı
  CUSTOMER_COUNT    // Müşteri sayısı
  STREAK            // Ardışık gün/hafta
  SPECIAL           // Özel rozetler
}

model Badge {
  id          String    @id @default(uuid())
  name        String
  description String
  iconUrl     String?
  type        BadgeType
  criteria    Json      // { threshold: 10, insuranceType?: "KASKO" }
  points      Int       @default(0) // Bonus puan
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  
  taliBadges  TaliBadge[]
}

model TaliBadge {
  id        String   @id @default(uuid())
  taliId    String
  tali      TaliProfile @relation(fields: [taliId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())
  
  @@unique([taliId, badgeId])
  @@index([taliId])
}

